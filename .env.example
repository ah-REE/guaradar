# Names only. Never commit values.
# Copy to .env and fill in locally. .env is gitignored.

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
# Public anon key. Safe to ship to the browser ONLY because RLS is correct.
SUPABASE_ANON_KEY=
# Server only. Must never appear in frontend env or the built bundle (COST-1).
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstream data sources --------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GEOGLOWS_BASE_URL=https://geoglows.ecmwf.int/api/v2
# Guayas main stem, resolved by getriverid on 2026-10-25
GEOGLOWS_RIVER_ID=670068009

# --- Simulation -------------------------------------------------------------
# Deterministic seeding so screenshots and rehearsals reproduce.
DEMO_SEED=20261025
# dry | steady | heavy | surge
SIM_PROFILE=surge

# --- Map tiles --------------------------------------------------------------
TILE_PROVIDER_URL=

# --- Optional ---------------------------------------------------------------
SENTRY_DSN=
