# Names only. Never commit values.
# Copy to .env and fill in locally. .env is gitignored.

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
# Public anon key. Safe to ship to the browser ONLY because RLS is correct.
SUPABASE_ANON_KEY=
# Server only. Must never appear in frontend env or the built bundle (COST-1).
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstream data sources --------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GEOGLOWS_BASE_URL=https://geoglows.ecmwf.int/api/v2
# Guayas main stem, resolved by getriverid on 2026-10-25
GEOGLOWS_RIVER_ID=670068009

# --- Simulation -------------------------------------------------------------
# Deterministic seeding so screenshots and rehearsals reproduce.
DEMO_SEED=20261025
# dry | steady | heavy | surge
SIM_PROFILE=surge

# --- Map tiles --------------------------------------------------------------
TILE_PROVIDER_URL=

# --- Optional ---------------------------------------------------------------
SENTRY_DSN=

# --- Community road reports (M15) -------------------------------------------
# Freshness window: how long a report counts as current evidence. Staleness is DERIVED from
# this at read time; it is never stored, so an expired closure keeps closing its road.
ROAD_REPORT_STALE_AFTER_MINUTES=360
# Upload ceiling, enforced before any image decoding happens.
MAX_ROAD_REPORT_IMAGE_BYTES=5242880
# How close a pin must be to a road to be matched to it. A miss is reported, never guessed.
ROAD_REPORT_SNAP_THRESHOLD_M=50
# A GPS fix worse than this cannot be matched automatically, even if it lands near a road.
ROAD_REPORT_MAX_ACCURACY_M=100

# --- Terrain (feature F/G — NOT IMPLEMENTED in this pass) --------------------
# Deliberately absent: the SRTM pipeline is a separate approved step. Nothing reads these yet,
# and adding them here without code would imply terrain risk is active when it is not.
# OPENTOPOGRAPHY_API_KEY=
# TERRAIN_RISK_ENABLED=false
